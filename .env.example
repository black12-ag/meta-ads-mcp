# Every environment variable Viral4All Ads reads. Names only; no live values.
# Public web config lives in .env (committed). Server secrets go in .env.local for local
# development (gitignored) and in your server's environment.

# --- Firebase web app (public) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Server only ---
# PostgreSQL connection string, e.g. postgresql://user:pass@127.0.0.1:5432/ethio_ads
DATABASE_URL=
# Firebase project id, used to verify login tokens (public value).
FIREBASE_PROJECT_ID=
# Folder where uploaded ad creatives are stored.
CREATIVES_DIR=
# Random string used to sign creative preview URLs.
CREATIVE_URL_SECRET=
# 64 hex chars (openssl rand -hex 32). Encrypts stored Meta access tokens; changing it makes stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=
# Public HTTPS origin Meta redirects back to.
PUBLIC_BASE_URL=
HOST=127.0.0.1
PORT=8094

# Meta app credentials (Meta for Developers -> App -> Settings -> Basic).
META_APP_ID=
META_APP_SECRET=
# Exact redirect URI registered in the Meta app's Valid OAuth Redirect URIs. Leave unset to use
# PUBLIC_BASE_URL + /api/public/meta/callback.
META_REDIRECT_URI=

# Must match the Verify token entered in Meta -> Webhooks.
META_WEBHOOK_VERIFY_TOKEN=
# Scheduler sends it as the "x-cron-secret" header to POST /api/public/meta/sync.
META_SYNC_CRON_SECRET=

# --- Email (Resend) ---
# Resend API key (secret). Unset = emails are skipped with a log line, e.g. in local dev and tests.
RESEND_API_KEY=
# Sender for every email; its domain must be verified in Resend. Default: Viral4All Ads <alerts@viral4all.com>
EMAIL_FROM=
# Where replies go. Default: support@viral4all.com
EMAIL_REPLY_TO=

# --- Cloudflare Turnstile (optional "I'm not a robot" on sign-in) ---
# Unset = the human check is skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
